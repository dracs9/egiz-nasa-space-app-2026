          },
          "missing": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "slope_f100_p50_deg",
                "slope_f100_p90_deg",
                "frac_lt10_f100",
                "frac_lt20_f100",
                "tri_f100_m",
                "slope_f400_p50_deg",
                "slope_f400_p90_deg",
                "frac_lt10_f400",
                "frac_lt20_f400",
                "tri_f400_m",
                "slope_r_p50_deg",
                "slope_r_p90_deg",
                "frac_lt20_r",
                "relief_m",
                "elev_min_m",
                "precip_mm",
                "bare_frac",
                "t_min_c",
                "t_max_c"
              ]
            },
            "uniqueItems": true
          },
          "snow_free_frac": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "minItems": 12,
            "maxItems": 12
          }
        },
        "required": [
          "id",
          "pool",
          "stratum",
          "name",
          "country",
          "lon",
          "lat",
          "attrs",
          "context",
          "missing"
        ]
      }
    }
  },
  "required": [
    "schema",
    "version",
    "generated_at",
    "synthetic",
    "provenance",
    "tiles_hash",
    "tiles"
  ]
}
