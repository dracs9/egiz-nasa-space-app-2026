{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egiz.local/contracts/engineering_session.schema.json",
  "title": "EGIZ engineering session 1.0.0",
  "description": "Portable complete operating-study records. Import reexecutes inputs against the loaded measured bundle; schema validity alone does not authenticate telemetry or sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "study",
    "map"
  ],
  "properties": {
    "schema": {
      "const": "egiz.engineering_session"
    },
    "version": {
      "const": "1.0.0"
    },
    "study": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "version",
        "id",
        "createdAt",
        "requirements",
        "space",
        "baseline",
        "options",
        "status",
        "planned",
        "elapsedMs",
        "budgetMs"
      ],
      "properties": {
        "schema": {
          "const": "egiz.operating_study"
        },
        "version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        },
        "space": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "varySpeed",
            "minSpeed",
            "maxSpeed",
            "samples",
            "routes"
          ],
          "properties": {
            "varySpeed": {
              "type": "boolean"
            },
            "minSpeed": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 5
            },
            "maxSpeed": {
              "type": "number",
              "minimum": 0.01,
              "maximum": 5
            },
            "samples": {
              "type": "integer",
              "minimum": 2,
              "maximum": 7
            },
            "routes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "astar",
                  "astar-energy",
                  "direct"
                ]
              }
            }
          }
        },
        "baseline": {
          "$ref": "#/$defs/option"
        },
        "options": {
          "type": "array",
          "maxItems": 21,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "status": {
          "enum": [
            "complete",
            "budget_exhausted"
          ]
        },
        "planned": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "budgetMs": {
          "type": "number",
          "minimum": 100,
          "maximum": 20000
        }
      }
    },
    "map": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "schema": {
          "const": "egiz.decision_map"
        },
        "version": {
          "const": "1.0.0"
        },
        "studyId": {
          "type": "string"
        },
        "candidateIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "complete",
            "budget_exhausted"
          ]
        },
        "elapsedMs": {
          "type": "number",
          "minimum": 0
        },
        "cells": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "object",
            "required": [
              "rollingFactor",
              "efficiencyFactor",
              "winnerId",
              "runs"
            ],
            "properties": {
              "rollingFactor": {
                "enum": [
                  0.8,
                  1,
                  1.3
                ]
              },
              "efficiencyFactor": {
                "enum": [
                  0.85,
                  1,
                  1.05
                ]
              },
              "winnerId": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "runs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "$ref": "#/$defs/option"
                }
              }
            }
          }
        }
      },
      "required": [
        "schema",
        "version",
        "studyId",
        "candidateIds",
        "cells",
        "elapsedMs",
        "status"
      ]
    }
  },
  "$defs": {
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDurationS",
        "maxEnergyWh",
        "minReserveWh",
        "minAltitudeM",
        "maxTouchdownMS"
      ],
      "properties": {
        "maxDurationS": {
          "type": "number",
          "minimum": 0
        },
        "maxEnergyWh": {
          "type": "number",
          "minimum": 0
        },
        "minReserveWh": {
          "type": "number",
          "minimum": 0
        },
        "minAltitudeM": {
          "type": "number",
          "minimum": 0
        },
        "maxTouchdownMS": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "schema",
        "version",
        "model",
        "id",
        "createdAt",
        "scenario",
        "terrain",
        "inputs",
        "integrator",
        "frames",
        "events",
        "route",
        "outcome",
        "metrics"
      ],
      "properties": {
        "schema": {
          "const": "egiz.experiment"
        },
        "version": {
          "const": "1.0.0"
        },
        "model": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "scenario": {
          "type": "object"
        },
        "terrain": {
          "type": "object"
        },
        "inputs": {
          "type": "object"
        },
        "frames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120005
        },
        "events": {
          "type": "array"
        },
        "requirements": {
          "$ref": "#/$defs/requirements"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run",
        "gates",
        "feasible",
        "margin",
        "pareto"
      ],
      "properties": {
        "run": {
          "$ref": "#/$defs/run"
        },
        "gates": {
          "type": "array"
        },
        "feasible": {
          "type": "boolean"
        },
        "margin": {
          "type": [
            "number",
            "null"
          ]
        },
        "pareto": {
          "type": "boolean"
        }
      }
    }
  }
}
