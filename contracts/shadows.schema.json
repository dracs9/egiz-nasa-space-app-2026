{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egiz.example/contracts/shadows.schema.json",
  "title": "Egiz shadows 1.x",
  "type": "object",
  "properties": {
    "schema": {
      "const": "egiz.shadows"
    },
    "version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "synthetic": {
      "type": "boolean"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dataset": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "period": {
            "type": "string"
          }
        },
        "required": [
          "dataset",
          "provider",
          "version",
          "url",
          "role"
        ]
      },
      "minItems": 1
    },
    "grid": {
      "type": "object",
      "properties": {
        "h_deg": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "az_deg": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "h_deg",
        "az_deg"
      ]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "target",
              "tile"
            ]
          },
          "sf": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "required": [
          "id",
          "kind",
          "sf"
        ]
      }
    }
  },
  "required": [
    "schema",
    "version",
    "generated_at",
    "synthetic",
    "provenance",
    "grid",
    "items"
  ]
}
